# Copy to .env and edit. Every value below is the built-in default unless
# marked otherwise, so a development run only needs the compose credentials.

# --- Deployment ---------------------------------------------------------
# "development" or "production". In production the app refuses to start if
# DATABASE_URL, REDIS_URL, SES_SENDER or PUBLIC_BASE_URL are still at their
# development defaults, if PUBLIC_BASE_URL is not https, or if
# SESSION_COOKIE_SECURE is off.
ENVIRONMENT=development
# Public origin this service is reachable at. Used for links in email and for
# OAuth redirect URIs when an application has no primary domain.
PUBLIC_BASE_URL=http://localhost:8000

# --- docker compose -----------------------------------------------------
# Read by docker-compose.yml to provision Postgres and to build the app's
# DATABASE_URL. Change the password before exposing anything.
POSTGRES_USER=ezauth
POSTGRES_PASSWORD=ezauth
POSTGRES_DB=ezauth
# Host-side ports, all bound to 127.0.0.1.
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=8000

# --- Database -----------------------------------------------------------
# Ignored by the app container, which is pointed at the compose service.
DATABASE_URL=postgresql+asyncpg://ezauth:ezauth@localhost:5432/ezauth
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Email (AWS SES) ----------------------------------------------------
SES_REGION=us-east-1
SES_SENDER=do-not-reply@example.com
SES_SENDER_NAME=ezAuth
MAIL_CHARSET=UTF-8
# SES credentials come from the standard AWS chain. Set them here only if the
# host has no instance role or shared credentials file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- JWT ----------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Upper bound for backend-minted sign-in tokens.
MAX_SIGNIN_TOKEN_LIFETIME_SECONDS=86400

# --- Sessions -----------------------------------------------------------
SESSION_COOKIE_NAME=__session
REFRESH_COOKIE_NAME=__refresh
# The refresh cookie is scoped to the refresh endpoint so it is not sent with
# every request.
REFRESH_COOKIE_PATH=/v1/tokens
# Suffix the cookie names with the application id so two applications served
# from one domain do not overwrite each other's session.
SESSION_COOKIE_PER_APP=true
# Leave empty to scope the cookie to the request host, or set a parent domain
# such as .example.com to share it across subdomains.
SESSION_COOKIE_DOMAIN=
# Must stay true in production. Set false only for plain-http local work.
SESSION_COOKIE_SECURE=true
# Check the sessions table on every cookie/bearer request so that logout and
# revocation take effect before the access token expires.
SESSION_REVOCATION_CHECK=true

# --- Rate limits --------------------------------------------------------
# Format is "window_seconds:max_count".
SIGNUP_RATE_LIMIT_IP=60:10
SIGNUP_RATE_LIMIT_EMAIL=300:1
SIGNIN_RATE_LIMIT_IP=60:10
SIGNIN_RATE_LIMIT_EMAIL=300:3
CODE_VERIFY_RATE_LIMIT_IP=300:20
CODE_VERIFY_RATE_LIMIT_EMAIL=300:5
ADMIN_AUTH_RATE_LIMIT_IP=3600:10
ADMIN_AUTH_RATE_LIMIT_EMAIL=3600:5
ADMIN_VERIFY_RATE_LIMIT_IP=3600:20
ADMIN_VERIFY_RATE_LIMIT_EMAIL=3600:10
# Wrong-code guesses allowed before an auth attempt is burned.
MAX_CODE_ATTEMPTS=5

# --- Auth token lifetimes ----------------------------------------------
VERIFICATION_TOKEN_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=15

# --- Dashboard ----------------------------------------------------------
# Comma-separated emails granted full (superadmin) dashboard access.
DASHBOARD_ADMIN_EMAILS=
DASHBOARD_SESSION_TTL_SECONDS=43200
# Comma-separated origins allowed to call /dashboard with credentials.
DASHBOARD_ALLOWED_ORIGINS=

# --- Hashcash proof-of-work --------------------------------------------
# Enabled by default; signup returns 422 without a proof when it is on.
HASHCASH_ENABLED=true
HASHCASH_DIFFICULTY=5
HASHCASH_CHALLENGE_TTL=300
HASHCASH_TIME_COST=2
HASHCASH_MEMORY_COST=19456
HASHCASH_PARALLELISM=1
HASHCASH_HASH_LEN=32

# --- Bot authentication -------------------------------------------------
CONFIRMATIONS_API_URL=https://api.confirmations.info
BOT_AUTH_TIMESTAMP_TOLERANCE=300

# --- OAuth --------------------------------------------------------------
OAUTH_STATE_TTL_SECONDS=600
OAUTH_STATE_COOKIE_NAME=__oauth_state

# --- Custom tables ------------------------------------------------------
CUSTOM_TABLES_STORAGE_LIMIT_BYTES=104857600

# --- S3 object storage --------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
OBJECT_STORAGE_MAX_OBJECT_BYTES=52428800
OBJECT_STORAGE_LIMIT_BYTES=1073741824

# --- Background cleanup -------------------------------------------------
CLEANUP_INTERVAL_SECONDS=3600
AUTH_ATTEMPT_RETENTION_DAYS=7
EXPIRED_SESSION_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
